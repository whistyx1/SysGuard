#!/bin/bash

set -euo pipefail

script_dir="$(dirname "$(realpath "$0")")"


argument="${1:-menu}"
disk_path="${2:-/}"

case "$argument" in
    "--help" | "-h")
        bash "$script_dir/help.sh"
        ;;
    "--version" | "-v")
        echo "SysGuard version 0.1.0"
        ;;
    "menu")
        source "$script_dir/menu.sh"
        case "$choice" in
            "1")
                bash "$script_dir/modules/system.sh"
                ;;
            "2")
                bash "$script_dir/modules/disk.sh" "${disk_path}"
                ;;
            "3")
                bash "$script_dir/modules/memory.sh"
                ;;
            *)
                echo "Invalid choice. Exiting."
                exit 1
                ;;
        esac
        ;;
    "system")
        bash "$script_dir/modules/system.sh"
        ;;
    "disk")
        bash "$script_dir/modules/disk.sh" "${2:-/}"
        ;;
    "memory")
        bash "$script_dir/modules/memory.sh"
        ;;
    *)
        echo "Invalid argument. Use --help for usage information."
        exit 1
        ;;
esac
