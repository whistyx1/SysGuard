#!/bin/bash

set -euo pipefail

if ! script_path=$(realpath "$0"); then
    printf 'Could not resolve SysGuard script path.\n' >&2
    exit 1
fi
script_dir="$(dirname "$script_path")"


argument="${1-menu}"
disk_path="${2-}"

if (( $# > 2 )); then
    printf 'Invalid arguments. Use --help for usage information.\n' >&2
    exit 1
fi
if (( $# == 2 )); then
    case "$argument:$2" in
        disk:*) ;;
        cpu:--per-core) ;;
        *)
            printf 'Invalid arguments. Use --help for usage information.\n' >&2
            exit 1
            ;;
    esac
fi

if (( $# == 2 )) && [[ -z "$disk_path" ]]; then
    printf 'Disk path cannot be empty.\n' >&2
    exit 1
fi

case "$argument" in
    "--help" | "-h")
        bash "$script_dir/help.sh"
        ;;
    "--version" | "-v")
        echo "SysGuard version 0.1.0"
        ;;
    "menu")
        source "$script_dir/menu.sh"
        case "$choice" in
            "1")
                bash "$script_dir/modules/system.sh"
                ;;
            "2")
                if [[ -n "$disk_path" ]]; then
                    bash "$script_dir/modules/disk.sh" "$disk_path"
                else
                    bash "$script_dir/modules/disk.sh"
                fi
                ;;
            "3")
                bash "$script_dir/modules/memory.sh"
                ;;
            "4")
                bash "$script_dir/modules/processes.sh"
                ;;
            "5")
                bash "$script_dir/modules/cpu.sh"
                ;;
            "6")
                for module in system cpu memory disk processes; do
                    bash "$script_dir/modules/${module}.sh"
                done
                ;;
            "7")
                bash "$script_dir/modules/disk.sh" --io
                ;;
            *)
                printf 'Invalid choice. Exiting.\n' >&2
                exit 1
                ;;
        esac
        ;;
    "system")
        bash "$script_dir/modules/system.sh"
        ;;
    "disk")
        if (( $# == 2 )); then
            bash "$script_dir/modules/disk.sh" "$disk_path"
        else
            bash "$script_dir/modules/disk.sh"
        fi
        ;;
    "memory")
        bash "$script_dir/modules/memory.sh"
        ;;
    "processes")
        bash "$script_dir/modules/processes.sh"
        ;;
    "cpu")
        if (( $# == 2 )); then
            bash "$script_dir/modules/cpu.sh" "$2"
        else
            bash "$script_dir/modules/cpu.sh"
        fi
        ;;
    "all")
        for module in system cpu memory disk processes; do
            bash "$script_dir/modules/${module}.sh"
        done
        ;;
    *)
        printf 'Invalid argument. Use --help for usage information.\n' >&2
        exit 1
        ;;
esac
